# ==========================================
# ThingsBoard Configuration
# ==========================================
# Base URL of your ThingsBoard instance
THINGSBOARD_HOST=https://schnelliot.in
THINGSBOARD_USERNAME=your_username_or_email@example.com
THINGSBOARD_PASSWORD=your_thingsboard_password

# Comma-separated list of Light UIDs (Device IDs or Device Names)
LIGHT_UIDS=LIGHT_UID_001,LIGHT_UID_002,LIGHT_UID_003,LIGHT_UID_004,LIGHT_UID_005

# Telemetry key to check for relay status (e.g. relayStatus, status, state, relay, lightState)
# If left empty, the client will attempt to automatically detect the relay key.
TELEMETRY_RELAY_KEY=relayStatus

# ==========================================
# Audit Schedule Configuration
# ==========================================
# Audit time slots (24-hour HH:MM format, comma separated)
AUDIT_TIMINGS=07:30,09:30

# Park working hours daytime alert window (lights ON during this time will trigger energy waste alerts)
DAYLIGHT_START=06:00
DAYLIGHT_END=18:00

# ==========================================
# Email Notification / SMTP Configuration
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@gmail.com
RECIPIENT_EMAILS=admin@bbmp.gov.in,supervisor@bbmp.gov.in

# Option to save generated HTML email reports locally in logs/ directory
SAVE_LOCAL_HTML=True

# Region & Zone Configuration
DEFAULT_REGION=Bangalore Urban
DEFAULT_ZONE=BBMP South Zone

