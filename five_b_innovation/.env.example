# ==============================================================================
# 5B INNOVATION PARK LIGHTS - CONFIGURATION TEMPLATE
# ==============================================================================

# ThingsBoard IoT Platform
THINGSBOARD_HOST=https://schnelliot.in
THINGSBOARD_USERNAME=your_username@example.com
THINGSBOARD_PASSWORD=your_password
THINGSBOARD_CUSTOMER_ID=3e268290-3989-11f1-9e5f-85a6074555d7
TELEMETRY_RELAY_KEY=rly

# Google Sheets Configuration
SERVICE_ACCOUNT_FILE=service.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID_OR_URL=https://docs.google.com/spreadsheets/d/your_spreadsheet_id
GOOGLE_WORKSHEET_NAME=

# Audit Timings (4-Slot Checkpoints)
# Run 1: 19:00 (Evening 7 PM - Expected: ON)
# Run 2: 22:00 (Evening 10 PM - Expected: OFF)
# Run 3: 05:00 (Morning 5 AM - Expected: ON)
# Run 4: 07:00 (Morning 7 AM - Expected: OFF)
AUDIT_TIMINGS=19:00,22:00,05:00,07:00
EXPECTED_DAILY_RUNS=4

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@gmail.com
RECIPIENT_EMAILS=recipient1@example.com,recipient2@example.com
BCC_EMAILS=

EMAIL_SUBJECT_PREFIX=[5B Innovation Park Lights Daily Audit]
ENABLE_EMAIL_THREADING=True
EMAIL_THREAD_ID=5b-innovation-park-lights-audit-thread@schnellenergy.com

SAVE_LOCAL_HTML=True
RESET_STORAGE_AFTER_REPORT=False

